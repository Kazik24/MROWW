  "architecture_findings": {
    "existing_threads": [
      "Dedicated thread per plot",
      "Background LLVM compilation worker",
      "Ordered network writer per connection"
    ],
    "input_latency": "Plot simulation can run for 200 ms before processing player packets; the measured visual cap is 5 Hz.",
    "scaling": "Every Plot creates its own Tokio Runtime::new() for async helpers; sharing background IO is a separate many-plot resource optimization.",
    "safe_worker_boundary": "One worker exclusively owns Compiler/native state. Plot thread sends ordered controls applied between native batches and receives coalesced visible state plus lossless ordered events. Pause/save/reset/fallback/unload require ownership barriers and complete state handoff.",
    "recommendation": "For higher single-plot TPS, isolate native hot-path and batching costs before introducing worker queues. For responsiveness under presentation load, first measure a shorter input-service time budget; a dedicated simulation worker is a larger alternative."
  },
  "not_checked": [
    "Multiplayer or moving-client/chunk-streaming load",
    "Full piston presentation load",
    "A concurrent simulation/presentation worker prototype",
    "CPU-time/hardware-counter attribution of the batching-versus-scalar path"
  ],
